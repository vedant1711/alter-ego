  "cards": [
    {
      "dot": "violet",
      "title": "Three stores, one session",
      "items": [
        "Qdrant holds encrypted memory text and its 768d vector",
        "Neo4j holds entities and typed relationships",
        "BM25 is rebuilt in-process and invalidated on write"
      ]
    },
    {
      "dot": "emerald",
      "title": "Degrades instead of failing",
      "items": [
        "No QDRANT_URL falls back to Qdrant in :memory: mode",
        "No NEO4J_URI falls back to a networkx MultiDiGraph",
        "No GEMINI_API_KEY runs deterministic offline stubs"
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation and secrets",
      "items": [
        "Every store read filters on a 122-bit session id",
        "Memory text is encrypted with a per-session derived key",
        "All model calls are server-side; the browser never sees a key"
      ]
    }
  ]
