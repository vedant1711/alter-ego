# ---- LLM (Google AI Studio, free tier) ----
GEMINI_API_KEY=
# Check the current free-tier daily quota before changing this: the newest
# full flash models allow only ~20 requests/day free, while the flash-lite
# family carries the large allowance this project assumes. See ai.dev/rate-limit
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Gemini 3.x reasons before answering and bills those thinking tokens against
# MAX_OUTPUT_TOKENS. Left on the default it burns the budget thinking and the
# answer is truncated. MINIMAL/LOW/MEDIUM/HIGH; empty omits it (needed by 2.5).
GEMINI_THINKING_LEVEL=LOW
MAX_OUTPUT_TOKENS=2048

# ---- Knowledge graph (Neo4j Aura Free). Leave blank to use the in-process
# networkx fallback graph store (fine for local dev / demos). ----
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Vector store (Qdrant Cloud Free). Leave blank to use the in-process
# cosine-similarity fallback vector store. ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=memories

# ---- Encryption at rest ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- CORS: comma-separated list of allowed frontend origins ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- Guardrails ----
RATE_LIMIT_PER_MIN=8
MAX_MESSAGE_CHARS=2000
MAX_REQUESTS_PER_SESSION=60

# ---- Retrieval / summarization tuning ----
SUMMARY_THRESHOLD=12
SUMMARY_BATCH=8
RETRIEVAL_TOP_K=6
MAX_CONTEXT_CHARS=6000
